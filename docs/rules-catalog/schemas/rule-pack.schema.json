{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konformos.dev/schemas/rule-pack.schema.json",
  "title": "RulePack",
  "description": "حزمة قواعد مُصدَّرة لولاية (KonformOS v1.0 §8.3, v1.1 VAL-PACK-01/ID-02/ID-03 + INV-RP-03 + BR-LEG-03).",
  "type": "object",
  "additionalProperties": false,
  "required": ["jurisdiction", "version", "effective_from", "status", "legal_basis", "rule_refs"],
  "properties": {
    "jurisdiction": { "enum": ["DE", "EU", "US"] },
    "version": {
      "type": "string",
      "pattern": "^(DE|EU|US)-[0-9]{4}\\.[0-9]+(\\.[0-9]+)?$",
      "description": "VAL-ID-02: البادئة يجب أن تساوي jurisdiction (يُفحص في سكربت الاتساق)"
    },
    "effective_from": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["draft", "active", "superseded"] },
    "legal_basis": { "type": "string", "minLength": 1 },
    "rule_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_code", "weight", "mandatory"],
        "properties": {
          "rule_code": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$" },
          "weight": { "type": "integer", "minimum": 0, "maximum": 10 },
          "mandatory": { "type": "boolean" }
        }
      }
    },
    "report_template_id": { "type": ["string", "null"] },
    "seed": {
      "type": "boolean",
      "description": "BR-LEG-03: حزم البذر الأولى تحمل seed=true بدلاً من source_change_events"
    },
    "seed_provenance": { "type": "string", "description": "توثيق مصدر البذر (إلزامي منطقياً عند seed=true)" },
    "signed_by": { "type": ["string", "null"], "description": "UUID الموقّع — إلزامي عند النشر (INV-RP-03)" },
    "signed_at": { "type": ["string", "null"], "format": "date-time" },
    "source_change_events": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["active", "superseded"] } } },
      "then": {
        "properties": {
          "signed_by": { "type": "string", "minLength": 1 },
          "signed_at": { "type": "string", "format": "date-time" }
        },
        "required": ["signed_by", "signed_at"]
      }
    }
  ]
}
